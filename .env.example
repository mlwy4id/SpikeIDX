# Cloud Postgres (Supabase dashboard → Project Settings → Database → Connection string,
# pilih Session mode port 5432 agar CREATE EXTENSION + migrasi otomatis jalan).
# Contoh Supabase:
# DATABASE_URL=postgres://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?sslmode=require
# Contoh Neon:
# DATABASE_URL=postgres://<user>:<password>@<host>.neon.tech/neondb?sslmode=require
DATABASE_URL=
# Backend strict-Postgres via infra.WireStrict: gagal keras tanpa DATABASE_URL yang reachable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TZ=Asia/Jakarta
PORT=8080
